<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#176b55"><title>BookBuddy AI</title>
<style>
:root{--g:#176b55;--p:#e7f4ee;--ink:#17231f;--muted:#68756f;--line:#e1e8e4;--bg:#f4f7f5}*{box-sizing:border-box}body{margin:0;background:var(--bg);font:15px system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink)}button,input,select,textarea{font:inherit}.wrap{max-width:960px;margin:auto;padding:14px}.head{display:flex;align-items:center;gap:12px;margin:8px 0 18px}.logo{background:var(--g);color:white;border-radius:15px;padding:12px;font-size:23px}.brand{font-size:21px;font-weight:850}.muted,.desc{color:var(--muted);font-size:13px}.badge{margin-left:auto;background:#fff3d3;color:#765500;border-radius:20px;padding:7px 10px;font-size:11px;font-weight:800}.tabs{display:flex;gap:4px;background:#e8ecef;padding:5px;border-radius:15px;position:sticky;top:3px;z-index:3;margin-bottom:16px}.tab{flex:1;border:0;background:transparent;border-radius:11px;padding:12px 5px;font-weight:750;color:#5a6761}.tab.active{background:white;color:var(--ink)}.panel{display:none}.panel.active{display:block}.card{background:white;border:1px solid #edf0ee;border-radius:20px;padding:18px;margin-bottom:15px}.card h2{font-size:19px;margin:0 0 6px}.desc{line-height:1.5;margin:0 0 18px}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:14px}.field label{font-size:13px;font-weight:750}.field input,.field select,.field textarea,.chatrow input{padding:13px;border:1px solid var(--line);border-radius:12px;background:white;width:100%;min-width:0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.services{display:grid;grid-template-columns:1fr 1fr;gap:9px}.svc{display:flex;gap:8px;border:1px solid var(--line);border-radius:13px;padding:12px;cursor:pointer}.svc.selected{border-color:var(--g);background:#f0f8f4}.svc input{accent-color:var(--g);margin-top:3px}.svc strong{display:block;font-size:13px}.svc small{color:var(--muted)}.btn{border:0;background:var(--g);color:white;border-radius:12px;padding:14px;font-weight:800;width:100%}.secondary{background:var(--p);color:var(--g)}.hint{font-size:12px;color:var(--muted);background:#f7f9f8;padding:12px;border-radius:12px;line-height:1.5;margin-top:12px}.chips{display:flex;flex-wrap:wrap;gap:7px}.chip{background:#f0f5f2;padding:8px 10px;border-radius:20px;font-size:12px;font-weight:700}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f7faf8;padding:12px;border-radius:13px}.stat small{display:block;color:var(--muted);font-size:11px}.stat strong{font-size:22px}.booking{border:1px solid var(--line);border-radius:14px;padding:13px;margin-top:10px}.booking h3{font-size:15px;margin:0 0 6px}.booking p{font-size:12px;color:var(--muted);margin:4px 0}.status{font-size:10px;font-weight:800;color:var(--g);background:var(--p);padding:6px 8px;border-radius:20px}.cancel{background:#fff0ef;color:#b42318;border:0;border-radius:9px;padding:8px 10px;margin-top:9px}.chat{background:#f7faf8;padding:12px;border-radius:14px;margin-bottom:12px}.bubble{font-size:13px;line-height:1.5;padding:10px 12px;border-radius:13px;margin:7px 0;max-width:94%}.bot{background:white;border:1px solid var(--line)}.user{background:#dff4e8;margin-left:auto}.chatrow{display:flex;gap:7px}.chatrow button{width:auto}.footer{text-align:center;color:#85918b;font-size:11px;padding:14px}@media(max-width:600px){.grid,.services{grid-template-columns:1fr}.tab{font-size:11px}.wrap{padding:11px}.card{padding:15px}}
</style></head><body><main class="wrap">
<header class="head"><div class="logo">✂</div><div><div class="brand">BookBuddy AI</div><div class="muted">Bookings for appointment businesses</div></div><div class="badge">DEMO MODE</div></header>
<nav class="tabs"><button class="tab active" data-tab="book">Book</button><button class="tab" data-tab="dashboard">Dashboard</button><button class="tab" data-tab="setup">Business setup</button><button class="tab" data-tab="assistant">Assistant</button></nav>
<section id="book" class="panel active"><div class="card"><h2>Book an appointment</h2><p class="desc">Choose your business type, service and preferred time.</p>
<div class="field"><label for="type">Business type *</label><select id="type"><option value="barber">Barbershop</option><option value="salon">Salon & beauty</option><option value="clinic">Clinic / private practice</option><option value="tutor">Tutor / lessons</option><option value="other">Other appointment service</option></select></div>
<div class="field"><label for="biz">Business name</label><input id="biz" value="FreshCut Barbershop" maxlength="70"></div>
<div class="grid"><div class="field"><label for="customer">Your name *</label><input id="customer" placeholder="e.g. Brian Otieno" maxlength="80"></div><div class="field"><label for="phone">Phone / WhatsApp (optional)</label><input id="phone" placeholder="0712 345 678" inputmode="tel"></div></div>
<div class="field"><label>Choose a service *</label><div class="services" id="services"></div></div>
<div class="grid"><div class="field"><label for="date">Date *</label><input id="date" type="date"></div><div class="field"><label for="time">Time *</label><select id="time"></select></div></div>
<div class="field"><label for="notes">Notes (optional)</label><textarea id="notes" rows="2" maxlength="250" placeholder="Optional note"></textarea></div><button class="btn" id="save">Save demo booking</button><div class="hint">Demo only: bookings are saved in this browser on this device. No real slot is reserved and no WhatsApp message is sent.</div></div>
<div class="card"><h2 id="previewName">FreshCut Barbershop</h2><p class="desc" id="previewDesc">Barbershop · Nakuru, Kenya</p><div class="chips" id="previewServices"></div></div></section>
<section id="dashboard" class="panel"><div class="card"><h2>Business dashboard</h2><p class="desc">Demo appointments saved on this device.</p><div class="stats"><div class="stat"><small>Total requests</small><strong id="total">0</strong></div><div class="stat"><small>Upcoming</small><strong id="upcoming">0</strong></div><div class="stat"><small>Cancelled</small><strong id="cancelled">0</strong></div></div><h3>Appointment requests</h3><div id="list"></div><div class="grid" style="margin-top:12px"><button class="btn secondary" id="csv">Export CSV</button><button class="btn secondary" id="clear">Clear demo bookings</button></div><div class="hint">Real multi-user booking requires a secure backend database and authentication.</div></div></section>
<section id="setup" class="panel"><div class="card"><h2>Business setup</h2><p class="desc">Customize the business name, category and services for this browser demo.</p><div class="field"><label for="setupType">Business category</label><select id="setupType"><option value="barber">Barbershop</option><option value="salon">Salon & beauty</option><option value="clinic">Clinic / private practice</option><option value="tutor">Tutor / lessons</option><option value="other">Other appointment service</option></select></div><div class="field"><label for="setupName">Business name</label><input id="setupName" maxlength="70"></div><div class="field"><label for="location">Location (optional)</label><input id="location" maxlength="80" placeholder="e.g. Nakuru, Kenya"></div><div class="field"><label for="setupServices">Services and prices (one per line)</label><textarea id="setupServices" rows="6" placeholder="Haircut | 300&#10;Haircut + beard | 500"></textarea><small class="muted">Format: Service name | price in KSh</small></div><button class="btn" id="saveSetup">Save business setup</button><button class="btn secondary" id="reset" style="margin-top:8px">Restore sample business</button><div class="hint">Do not enter patient medical details in this demo. Real clinic use needs appropriate privacy and security controls.</div></div></section>
<section id="assistant" class="panel"><div class="card"><h2>Booking assistant</h2><p class="desc">Scripted demo responses, not a live AI or WhatsApp connection.</p><div class="chat" id="chat"><div class="bubble bot">Hi! 👋 I can explain supported businesses, booking steps, cancellations and reminders.</div></div><div class="chatrow"><input id="question" placeholder="Ask about bookings..." maxlength="300"><button class="btn" id="send">Send</button></div><div class="chips" style="margin-top:12px"><button class="btn secondary sample" style="width:auto" data-q="What businesses do you support?">Business types</button><button class="btn secondary sample" style="width:auto" data-q="How do reminders work?">Reminders</button><button class="btn secondary sample" style="width:auto" data-q="How do I cancel?">Cancellations</button></div><div class="hint">Real WhatsApp reminders require a WhatsApp Business Platform integration and server-side scheduling. Fees and setup requirements may apply.</div></div></section>
<div class="footer">BookBuddy AI · Multi-business prototype</div></main>
<script>
const defaults={barber:{name:"FreshCut Barbershop",location:"Nakuru, Kenya",services:[["Haircut",300],["Haircut + beard",500],["Beard trim",150],["Kids haircut",250]]},salon:{name:"Glow Beauty Studio",location:"Nakuru, Kenya",services:[["Wash & blow-dry",700],["Braids",2500],["Manicure",600],["Makeup",1800]]},clinic:{name:"CarePoint Clinic",location:"Nakuru, Kenya",services:[["General consultation",1500],["Follow-up visit",800],["Dental check-up",2000],["Wellness check",1200]]},tutor:{name:"BrightPath Tutoring",location:"Nakuru, Kenya",services:[["Math lesson (1 hour)",800],["English lesson (1 hour)",800],["Science lesson (1 hour)",900],["Exam preparation",1200]]},other:{name:"Your Appointment Service",location:"Nakuru, Kenya",services:[["Initial appointment",1000],["Standard session",1500],["Extended session",2500]]}};
const labels={barber:"Barbershop",salon:"Salon & beauty",clinic:"Clinic / private practice",tutor:"Tutor / lessons",other:"Other appointment service"};const $=id=>document.getElementById(id);let cfg,bookings=[],selected=0;
try{cfg=JSON.parse(localStorage.getItem("bbCfg"))||{type:"barber",...defaults.barber}}catch(e){cfg={type:"barber",...defaults.barber}}try{bookings=JSON.parse(localStorage.getItem("bbBookings"))||[]}catch(e){}
const saveCfg=()=>localStorage.setItem("bbCfg",JSON.stringify(cfg)),saveBookings=()=>localStorage.setItem("bbBookings",JSON.stringify(bookings)),money=n=>"KSh "+Number(n||0).toLocaleString("en-KE"),esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function servicesFrom(text){return text.split("\n").map(x=>x.trim()).filter(Boolean).map(x=>{let p=x.split("|");return [p.slice(0,-1).join("|").trim(),Number(p[p.length-1].trim().replace(/,/g,""))]}).filter(x=>x[0]&&Number.isFinite(x[1])&&x[1]>=0)}
function setType(t){cfg={type:t,...defaults[t],services:defaults[t].services.map(x=>[...x])};selected=0;saveCfg();render()}
function render(){ $("type").value=cfg.type;$("biz").value=cfg.name;$("previewName").textContent=cfg.name;$("previewDesc").textContent=labels[cfg.type]+" · "+(cfg.location||"Location not set");$("services").innerHTML=cfg.services.map((s,i)=>`<label class="svc ${i===selected?"selected":""}"><input type="radio" name="svc" value="${i}" ${i===selected?"checked":""}><span><strong>${esc(s[0])}</strong><small>${money(s[1])}</small></span></label>`).join("");document.querySelectorAll('input[name="svc"]').forEach(el=>el.onchange=()=>{selected=+el.value;document.querySelectorAll(".svc").forEach((x,i)=>x.classList.toggle("selected",i===selected))});$("previewServices").innerHTML=cfg.services.map(s=>`<span class="chip">${esc(s[0])} · ${money(s[1])}</span>`).join("");$("setupType").value=cfg.type;$("setupName").value=cfg.name;$("location").value=cfg.location||"";$("setupServices").value=cfg.services.map(s=>s[0]+" | "+s[1]).join("\n");renderBookings()}
function renderBookings(){let today=new Date().toISOString().slice(0,10),active=bookings.filter(b=>!b.cancelled);$("total").textContent=bookings.length;$("upcoming").textContent=active.filter(b=>b.date>=today).length;$("cancelled").textContent=bookings.filter(b=>b.cancelled).length;$("list").innerHTML=bookings.length?bookings.slice().reverse().map(b=>`<div class="booking"><div style="display:flex;justify-content:space-between;gap:8px"><div><h3>${esc(b.customer)} · ${esc(b.service)}</h3><p>${esc(b.business)} · ${esc(b.category)}</p><p>${esc(b.date)} at ${esc(b.time)} · ${money(b.price)}</p><p>${b.phone?"Phone: "+esc(b.phone):"No phone"}${b.notes?" · "+esc(b.notes):""}</p></div><span class="status" style="${b.cancelled?"color:#b42318;background:#fff0ef":""}">${b.cancelled?"CANCELLED":"REQUESTED"}</span></div>${b.cancelled?"":`<button class="cancel" onclick="cancelBooking('${b.id}')">Cancel request</button>`}</div>`).join(""):'<p class="muted">No demo bookings yet. Make a test booking in the Book tab.</p>'}
window.cancelBooking=id=>{let b=bookings.find(x=>x.id===id);if(b){b.cancelled=true;saveBookings();renderBookings()}}
function tab(id){document.querySelectorAll(".tab").forEach(b=>b.classList.toggle("active",b.dataset.tab===id));document.querySelectorAll(".panel").forEach(p=>p.classList.toggle("active",p.id===id));if(id==="dashboard")renderBookings()}
document.querySelectorAll(".tab").forEach(b=>b.onclick=()=>tab(b.dataset.tab));$("type").onchange=e=>setType(e.target.value);$("biz").onchange=e=>{cfg.name=e.target.value.trim()||defaults[cfg.type].name;saveCfg();render()};
for(let h=8;h<=19;h++)for(let m of [0,30])if(!(h===19&&m===30)){let d=new Date();d.setHours(h,m,0,0);$("time").add(new Option(d.toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit"})))}
$("date").min=new Date().toISOString().slice(0,10);$("date").value=$("date").min;
$("save").onclick=()=>{let customer=$("customer").value.trim(),date=$("date").value;if(!customer)return alert("Please enter your name.");if(!cfg.services.length)return alert("Add at least one service in Business setup.");if(!date||date<new Date().toISOString().slice(0,10))return alert("Choose today or a future date.");let s=cfg.services[selected]||cfg.services[0];bookings.push({id:Date.now().toString(36)+Math.random().toString(36).slice(2,6),customer,phone:$("phone").value.trim(),business:cfg.name,category:labels[cfg.type],service:s[0],price:s[1],date,time:$("time").value,notes:$("notes").value.trim(),cancelled:false});saveBookings();renderBookings();$("customer").value=$("phone").value=$("notes").value="";alert("Demo booking saved on this device only. No WhatsApp message was sent.");tab("dashboard")};
$("saveSetup").onclick=()=>{let name=$("setupName").value.trim(),services=servicesFrom($("setupServices").value);if(!name)return alert("Enter a business name.");if(!services.length)return alert("Add services using Service name | price");cfg={type:$("setupType").value,name,location:$("location").value.trim(),services};selected=0;saveCfg();render();tab("book");alert("Business setup saved on this device.")};$("setupType").onchange=e=>{const t=e.target.value;$("setupServices").value=defaults[t].services.map(s=>s[0]+" | "+s[1]).join("\n");if(!$("setupName").value||Object.values(defaults).some(d=>d.name===$("setupName").value))$("setupName").value=defaults[t].name};$("reset").onclick=()=>{setType("barber")};
$("csv").onclick=()=>{if(!bookings.length)return alert("No bookings to export.");let rows=[["Customer","Phone","Business","Category","Service","Price KSh","Date","Time","Status","Notes"],...bookings.map(b=>[b.customer,b.phone,b.business,b.category,b.service,b.price,b.date,b.time,b.cancelled?"Cancelled":"Requested",b.notes])];let csv=rows.map(r=>r.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")).join("\r\n"),a=document.createElement("a");a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"}));a.download="bookbuddy-bookings.csv";a.click();URL.revokeObjectURL(a.href)};$("clear").onclick=()=>{if(confirm("Delete all demo bookings from this browser?")){bookings=[];saveBookings();renderBookings()}};
function answer(q){q=q.toLowerCase();if(/business|support|type|salon|clinic|tutor|barber/.test(q))return "This demo supports barbershops, salons and beauty businesses, clinics/private practices, tutors/lessons and other appointment services. Choose a category on Book or customize it in Business setup.";if(/remind|whatsapp|message|sms/.test(q))return "Reminders are not sent in this demo. A live version needs WhatsApp Business Platform integration and server-side scheduling. Fees and setup requirements may apply.";if(/cancel|reschedul/.test(q))return "Open Dashboard and tap Cancel request. This only marks a local demo booking as cancelled; it does not notify anyone.";if(/book|appointment|service/.test(q))return "On Book, choose a business category and service, enter your name and date/time, then tap Save demo booking. It saves in this browser only.";return "I can explain business types, demo bookings, cancellations and reminder plans. This is a scripted demo assistant, not live AI."}
function send(q){q=(q||$("question").value).trim();if(!q)return;$("chat").insertAdjacentHTML("beforeend",`<div class="bubble user">${esc(q)}</div><div class="bubble bot">${esc(answer(q))}</div>`);$("question").value=""}
$("send").onclick=()=>send();$("question").onkeydown=e=>{if(e.key==="Enter")send()};document.querySelectorAll(".sample").forEach(b=>b.onclick=()=>send(b.dataset.q));render();
</script></body></html>