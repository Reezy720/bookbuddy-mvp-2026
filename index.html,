<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#111827">
<title>BookBuddy AI — Booking Demo</title>
<style>
  :root{--bg:#f4f6fa;--card:#fff;--ink:#172033;--muted:#697386;--line:#e5e9f1;--brand:#286b55;--brand2:#1d503f;--soft:#e9f5ef;--danger:#b42318;--warning:#fff5d6;--shadow:0 8px 26px rgba(18,31,53,.07)}
  *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  button,input,select,textarea{font:inherit}button{cursor:pointer}.app{max-width:1060px;margin:auto;padding:16px 14px 40px}
  header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.brand{display:flex;align-items:center;gap:10px}.logo{width:42px;height:42px;border-radius:14px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:22px}.brand h1{font-size:19px;line-height:1.1;margin:0}.brand p{margin:4px 0 0;color:var(--muted);font-size:12px}
  .demo-pill{font-size:11px;font-weight:800;letter-spacing:.05em;background:var(--warning);padding:6px 9px;border-radius:999px;color:#785700;white-space:nowrap}
  .tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;background:#e8ebf2;padding:5px;border-radius:14px;margin-bottom:16px}.tab{border:0;border-radius:10px;background:transparent;padding:11px 7px;font-weight:700;color:#667085;font-size:13px}.tab.active{background:#fff;color:var(--ink);box-shadow:0 2px 8px #1822300d}
  .view{display:none}.view.active{display:block}.layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(270px,.9fr);gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:19px;box-shadow:var(--shadow);min-width:0}.card h2{font-size:18px;margin:0 0 5px}.sub{color:var(--muted);font-size:13px;margin:0 0 17px}.field{margin:13px 0}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;border:1px solid #d6dce7;background:#fff;border-radius:11px;padding:12px;color:var(--ink);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--brand);box-shadow:0 0 0 3px #286b551a}.two{display:grid;grid-template-columns:1fr 1fr;gap:10px}.btn{border:0;border-radius:11px;padding:12px 15px;font-weight:800;background:var(--brand);color:#fff;width:100%}.btn:hover{background:var(--brand2)}.btn.secondary{background:var(--soft);color:var(--brand)}.btn.small{width:auto;padding:8px 10px;font-size:12px}.service-list{display:grid;gap:9px}.service-option{display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:12px;padding:12px;cursor:pointer}.service-option.selected{border-color:var(--brand);background:#f0f8f3}.service-option input{accent-color:var(--brand)}.service-name{flex:1;font-weight:700}.price{font-weight:800}.note{background:#f7f9fc;border-radius:11px;padding:11px 12px;color:var(--muted);font-size:12px;margin-top:13px}.status{display:none;border-radius:11px;padding:11px 12px;margin-top:12px;font-size:13px}.status.show{display:block}.status.good{background:#e8f7ed;color:#17633b}.status.bad{background:#fff0ef;color:var(--danger)}.summary{display:grid;gap:10px}.summary-row{display:flex;justify-content:space-between;gap:12px;padding-bottom:10px;border-bottom:1px solid var(--line);font-size:13px}.summary-row span{color:var(--muted)}.summary-row strong{text-align:right}.metric-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}.metric{padding:15px;border:1px solid var(--line);border-radius:14px;background:#fff}.metric small{display:block;color:var(--muted);font-size:11px}.metric strong{font-size:21px;display:block;margin-top:4px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:13px}.toolbar h2{margin:0}.booking-list{display:grid;gap:10px}.booking{border:1px solid var(--line);border-radius:13px;padding:13px;display:flex;gap:12px;justify-content:space-between;align-items:center}.booking h3{font-size:14px;margin:0 0 4px}.booking p{font-size:12px;color:var(--muted);margin:0}.booking-right{text-align:right;white-space:nowrap}.tag{display:inline-block;border-radius:999px;padding:4px 8px;font-size:10px;font-weight:800;background:#e8f7ed;color:#17633b;margin-top:5px}.tag.cancelled{background:#fff0ef;color:var(--danger)}.empty{text-align:center;padding:28px 10px;color:var(--muted);font-size:13px}.chat{display:flex;flex-direction:column;gap:12px}.chat-messages{min-height:260px;max-height:390px;overflow:auto;display:flex;flex-direction:column;gap:10px;padding:4px 0}.bubble{max-width:88%;padding:11px 13px;border-radius:14px;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}.bubble.bot{align-self:flex-start;background:#f0f2f6;border-bottom-left-radius:4px}.bubble.user{align-self:flex-end;background:var(--soft);border-bottom-right-radius:4px}.chat-form{display:flex;gap:8px}.chat-form input{min-width:0;flex:1;border:1px solid #d6dce7;border-radius:11px;padding:12px}.chat-form button{width:auto}.quick-prompts{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 12px}.quick{border:1px solid var(--line);background:#fff;border-radius:999px;padding:7px 10px;font-size:12px;color:var(--brand);font-weight:700}.footer{text-align:center;color:var(--muted);font-size:11px;margin-top:18px}.danger-link{color:var(--danger);background:transparent;border:0;font-size:12px;font-weight:700;padding:5px}
  @media(max-width:720px){.app{padding:13px 11px 30px}.layout{grid-template-columns:1fr}.card{padding:16px}.metric-grid{gap:7px}.metric{padding:12px 10px}.metric strong{font-size:19px}.metric small{font-size:10px}.two{gap:8px}.booking{align-items:flex-start}.booking-right{white-space:normal}.brand h1{font-size:17px}}
  @media(max-width:370px){.demo-pill{font-size:9px}.tab{font-size:11px;padding:10px 4px}.two{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="brand"><div class="logo">✂</div><div><h1>BookBuddy AI</h1><p>Simple bookings for busy barbers</p></div></div>
    <span class="demo-pill">DEMO MODE</span>
  </header>
  <nav class="tabs" aria-label="Main navigation">
    <button class="tab active" data-view="book">Book a cut</button>
    <button class="tab" data-view="dashboard">Dashboard</button>
    <button class="tab" data-view="assistant">AI assistant</button>
  </nav>

  <main>
    <section class="view active" id="view-book">
      <div class="layout">
        <form class="card" id="booking-form" novalidate>
          <h2>Book your appointment</h2><p class="sub">Choose a service and request a time.</p>
          <div class="field"><label for="customer-name">Your name *</label><input id="customer-name" name="name" placeholder="e.g. Brian Otieno" autocomplete="name" required maxlength="70"></div>
          <div class="field"><label for="customer-phone">Phone number (optional)</label><input id="customer-phone" name="phone" placeholder="e.g. 0712 345 678" inputmode="tel" autocomplete="tel" maxlength="25"></div>
          <div class="field"><label>Choose a service *</label>
            <div class="service-list" id="service-list">
              <label class="service-option selected"><input type="radio" name="service" value="Haircut" checked><span class="service-name">Haircut</span><span class="price">KSh 300</span></label>
              <label class="service-option"><input type="radio" name="service" value="Haircut + beard"><span class="service-name">Haircut + beard</span><span class="price">KSh 500</span></label>
              <label class="service-option"><input type="radio" name="service" value="Beard trim"><span class="service-name">Beard trim</span><span class="price">KSh 150</span></label>
              <label class="service-option"><input type="radio" name="service" value="Kids haircut"><span class="service-name">Kids haircut</span><span class="price">KSh 250</span></label>
            </div>
          </div>
          <div class="two">
            <div class="field"><label for="booking-date">Date *</label><input id="booking-date" type="date" required></div>
            <div class="field"><label for="booking-time">Time *</label><select id="booking-time" required><option value="">Choose time</option><option value="10:00">10:00 AM</option><option value="12:00">12:00 PM</option><option value="14:00" selected>2:00 PM</option><option value="16:00">4:00 PM</option><option value="18:00">6:00 PM</option></select></div>
          </div>
          <button class="btn" type="submit">Save demo booking</button>
          <div id="booking-status" class="status" role="status" aria-live="polite"></div>
          <div class="note">Demo only: saving stores this booking in this browser on this device. It does not contact a barber, reserve a real slot, or send WhatsApp messages.</div>
        </form>
        <aside class="card">
          <h2>FreshCut Barbershop</h2><p class="sub">Sample business · Nakuru, Kenya</p>
          <div class="summary" id="booking-summary">
            <div class="summary-row"><span>Service</span><strong>Haircut</strong></div>
            <div class="summary-row"><span>Price</span><strong>KSh 300</strong></div>
            <div class="summary-row"><span>Date</span><strong id="summary-date">Today</strong></div>
            <div class="summary-row"><span>Time</span><strong>2:00 PM</strong></div>
          </div>
          <div class="note">Opening hours (sample): 9:00 AM–7:00 PM. All services and prices are editable demo content.</div>
          <button class="btn secondary" type="button" id="go-assistant" style="margin-top:13px">Ask the AI assistant</button>
        </aside>
      </div>
    </section>

    <section class="view" id="view-dashboard">
      <div class="metric-grid">
        <div class="metric"><small>Saved bookings</small><strong id="metric-total">0</strong></div>
        <div class="metric"><small>Active bookings</small><strong id="metric-active">0</strong></div>
        <div class="metric"><small>Potential value</small><strong id="metric-value">KSh 0</strong></div>
      </div>
      <div class="card">
        <div class="toolbar"><div><h2>Booking dashboard</h2><p class="sub" style="margin:4px 0 0">Bookings saved in this browser only.</p></div><button class="btn small secondary" id="export-csv" type="button">Export CSV</button></div>
        <div class="booking-list" id="booking-list"><div class="empty">No demo bookings yet. Create one from “Book a cut”.</div></div>
        <div style="display:flex;justify-content:flex-end;margin-top:12px"><button class="danger-link" id="clear-bookings" type="button">Clear demo data</button></div>
      </div>
      <p class="note">“Potential value” totals the prices of active saved demo bookings. It is not actual revenue.</p>
    </section>

    <section class="view" id="view-assistant">
      <div class="layout">
        <div class="card chat">
          <h2>Meet your AI receptionist</h2><p class="sub">Ask about sample prices, hours or how to book.</p>
          <div class="quick-prompts">
            <button class="quick" type="button" data-prompt="How much is a haircut?">Haircut price</button>
            <button class="quick" type="button" data-prompt="What time do you open?">Opening hours</button>
            <button class="quick" type="button" data-prompt="How do I book?">How to book</button>
          </div>
          <div class="chat-messages" id="chat-messages" aria-live="polite"><div class="bubble bot">Sasa! 👋 I'm the BookBuddy demo assistant. I can answer questions about sample services and explain how to request a booking.</div></div>
          <form class="chat-form" id="chat-form"><input id="chat-input" placeholder="Ask about prices or bookings…" autocomplete="off" maxlength="300" required><button class="btn" type="submit">Send</button></form>
          <div class="note">This is a scripted mock chat, not a live AI model. It does not send or receive WhatsApp messages.</div>
        </div>
        <aside class="card"><h2>Sample service menu</h2><p class="sub">Price list used by the demo assistant.</p><div class="summary">
          <div class="summary-row"><span>Haircut</span><strong>KSh 300</strong></div>
          <div class="summary-row"><span>Haircut + beard</span><strong>KSh 500</strong></div>
          <div class="summary-row"><span>Beard trim</span><strong>KSh 150</strong></div>
          <div class="summary-row"><span>Kids haircut</span><strong>KSh 250</strong></div>
        </div><button class="btn secondary" type="button" id="go-book" style="margin-top:15px">Go to booking form</button></aside>
      </div>
    </section>
  </main>
  <div class="footer">BookBuddy AI · Local prototype · No account or network connection required</div>
</div>
<script>
(function(){
  const STORAGE_KEY = "bookbuddy_demo_bookings_v1";
  const prices = {"Haircut":300,"Haircut + beard":500,"Beard trim":150,"Kids haircut":250};
  const $ = id => document.getElementById(id);
  const todayLocal = () => { const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`; };
  const dateInput=$("booking-date");
  dateInput.min=todayLocal();
  dateInput.value=todayLocal();
  function readBookings(){ try { const v=JSON.parse(localStorage.getItem(STORAGE_KEY)||"[]"); return Array.isArray(v)?v:[]; } catch(e){ return []; } }
  function writeBookings(items){ try { localStorage.setItem(STORAGE_KEY,JSON.stringify(items)); return true; } catch(e){ return false; } }
  function money(n){ return "KSh "+Number(n||0).toLocaleString("en-KE"); }
  function niceDate(s){ if(!s)return "—"; const d=new Date(s+"T12:00:00"); return d.toLocaleDateString("en-KE",{weekday:"short",day:"numeric",month:"short",year:"numeric"}); }
  function niceTime(s){ const [h,m]=s.split(":").map(Number); const ap=h>=12?"PM":"AM"; return `${h%12||12}:${String(m).padStart(2,"0")} ${ap}`; }
  function selectedService(){return document.querySelector('input[name="service"]:checked')?.value||"Haircut";}
  function refreshSummary(){
    const service=selectedService(), time=$("booking-time").value||"14:00";
    $("booking-summary").innerHTML=`<div class="summary-row"><span>Service</span><strong>${escapeHTML(service)}</strong></div><div class="summary-row"><span>Price</span><strong>${money(prices[service])}</strong></div><div class="summary-row"><span>Date</span><strong>${dateInput.value===todayLocal()?"Today":niceDate(dateInput.value)}</strong></div><div class="summary-row"><span>Time</span><strong>${niceTime(time)}</strong></div>`;
  }
  function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
  function setStatus(text,kind){const el=$("booking-status");el.textContent=text;el.className="status show "+kind;}
  function renderDashboard(){
    const all=readBookings(), active=all.filter(b=>b.status!=="Cancelled");
    $("metric-total").textContent=all.length;
    $("metric-active").textContent=active.length;
    $("metric-value").textContent=money(active.reduce((sum,b)=>sum+(prices[b.service]||0),0));
    const list=$("booking-list");
    if(!all.length){list.innerHTML='<div class="empty">No demo bookings yet. Create one from “Book a cut”.</div>';return;}
    list.innerHTML=all.slice().sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time)).map(b=>`
      <article class="booking">
        <div><h3>${escapeHTML(b.name)} · ${escapeHTML(b.service)}</h3><p>${escapeHTML(niceDate(b.date))} at ${escapeHTML(niceTime(b.time))}${b.phone?" · "+escapeHTML(b.phone):""}</p><span class="tag ${b.status==="Cancelled"?"cancelled":""}">${escapeHTML(b.status)}</span></div>
        <div class="booking-right"><strong>${money(prices[b.service]||0)}</strong><br>${b.status==="Cancelled"?"":`<button class="btn small secondary cancel-booking" data-id="${escapeHTML(b.id)}" type="button">Cancel</button>`}</div>
      </article>`).join("");
  }
  document.querySelectorAll(".tab").forEach(btn=>btn.addEventListener("click",()=>showView(btn.dataset.view)));
  function showView(name){document.querySelectorAll(".tab").forEach(b=>b.classList.toggle("active",b.dataset.view===name));document.querySelectorAll(".view").forEach(v=>v.classList.toggle("active",v.id==="view-"+name));if(name==="dashboard")renderDashboard();}
  $("go-assistant").addEventListener("click",()=>showView("assistant"));
  $("go-book").addEventListener("click",()=>showView("book"));
  document.querySelectorAll('input[name="service"]').forEach(r=>r.addEventListener("change",()=>{document.querySelectorAll(".service-option").forEach(el=>el.classList.toggle("selected",el.querySelector("input").checked));refreshSummary();}));
  dateInput.addEventListener("change",refreshSummary);$("booking-time").addEventListener("change",refreshSummary);
  $("booking-form").addEventListener("submit",e=>{
    e.preventDefault();
    const name=$("customer-name").value.trim(), phone=$("customer-phone").value.trim(), service=selectedService(), date=dateInput.value, time=$("booking-time").value;
    if(name.length<2){setStatus("Please enter your name (at least 2 characters).","bad");$("customer-name").focus();return;}
    if(!date||date<todayLocal()){setStatus("Choose today or a future date.","bad");dateInput.focus();return;}
    if(!time){setStatus("Please choose a time.","bad");$("booking-time").focus();return;}
    if(phone && !/^[+0-9()\-\s]{7,25}$/.test(phone)){setStatus("Check the phone number, or leave it blank.","bad");$("customer-phone").focus();return;}
    const all=readBookings();
    if(all.some(b=>b.date===date&&b.time===time&&b.status!=="Cancelled")){setStatus("That time already has a demo booking in this browser. Choose another time or cancel the existing demo booking.","bad");return;}
    const booking={id:"BB-"+Date.now().toString(36).toUpperCase(),name,phone,service,date,time,status:"Saved demo",createdAt:new Date().toISOString()};
    all.push(booking);
    if(!writeBookings(all)){setStatus("Your browser couldn't save the demo data. Check storage settings or try another browser.","bad");return;}
    setStatus("Demo booking saved on this device. No real appointment was made and no message was sent.","good");
    renderDashboard();
  });
  $("booking-list").addEventListener("click",e=>{
    const btn=e.target.closest(".cancel-booking");if(!btn)return;
    const all=readBookings(), b=all.find(x=>x.id===btn.dataset.id);if(b){b.status="Cancelled";writeBookings(all);renderDashboard();}
  });
  $("clear-bookings").addEventListener("click",()=>{if(confirm("Delete all BookBuddy demo bookings saved in this browser?")){localStorage.removeItem(STORAGE_KEY);renderDashboard();}});
  $("export-csv").addEventListener("click",()=>{
    const all=readBookings();if(!all.length){alert("There are no demo bookings to export yet.");return;}
    const rows=[["ID","Name","Phone","Service","Price KSh","Date","Time","Status"],...all.map(b=>[b.id,b.name,b.phone,b.service,prices[b.service]||0,b.date,b.time,b.status])];
    const csv=rows.map(row=>row.map(v=>'"'+String(v??"").replace(/"/g,'""')+'"').join(",")).join("\r\n");
    const url=URL.createObjectURL(new Blob([csv],{type:"text/csv;charset=utf-8;"}));const a=document.createElement("a");a.href=url;a.download="bookbuddy-demo-bookings.csv";a.click();URL.revokeObjectURL(url);
  });
  const messages=$("chat-messages");
  function addBubble(text,who){const el=document.createElement("div");el.className="bubble "+who;el.textContent=text;messages.appendChild(el);messages.scrollTop=messages.scrollHeight;}
  function replyTo(text){
    const q=text.toLowerCase();
    if(/price|cost|how much|charge|haircut|beard|service|menu/.test(q)){
      const found=Object.keys(prices).filter(k=>q.includes(k.toLowerCase())||(k==="Haircut"&&q.includes("cut")));
      if(found.length===1)return `${found[0]} costs ${money(prices[found[0]])}.`;
      return "Sample prices:\n• Haircut: KSh 300\n• Haircut + beard: KSh 500\n• Beard trim: KSh 150\n• Kids haircut: KSh 250";
    }
    if(/open|hour|close|when/.test(q))return "The sample opening hours are 9:00 AM–7:00 PM. Please confirm actual hours with the barber.";
    if(/book|appointment|available|slot|reserve|time/.test(q))return "To request a demo booking, tap “Book a cut”, enter your name, select a service, date and time, then tap “Save demo booking”. This does not reserve a real slot.";
    if(/location|where|address|nakuru/.test(q))return "The demo business is labelled FreshCut Barbershop in Nakuru, Kenya. This is sample information, not a verified business address.";
    if(/hello|hi\b|sasa|hey|habari/.test(q))return "Sasa! 👋 I can help with sample prices, opening hours and how to request a booking.";
    if(/whatsapp|message|text/.test(q))return "WhatsApp is not connected in this prototype, so I can't send messages. This demo only shows the booking workflow.";
    return "I'm a scripted demo assistant, so I can answer basic questions about prices, opening hours and bookings. Try asking “How much is a haircut?”";
  }
  $("chat-form").addEventListener("submit",e=>{e.preventDefault();const input=$("chat-input"),text=input.value.trim();if(!text)return;addBubble(text,"user");input.value="";setTimeout(()=>addBubble(replyTo(text),"bot"),180);});
  document.querySelectorAll("[data-prompt]").forEach(btn=>btn.addEventListener("click",()=>{ $("chat-input").value=btn.dataset.prompt;$("chat-form").requestSubmit();}));
  refreshSummary();renderDashboard();
})();
</script>
</body>
</html>